# QualifAI Configuration Example
APP_NAME="QualifAI"
DEBUG=False

# Brain Settings
OPENAI_API_KEY="sk-..."
MODEL_NAME="gpt-4o"

# Company Info
COMPANY_NAME="QualifAI Systems"
COMPANY_DESCRIPTION="AI-powered lead qualification and appointment booking."
BOOKING_LINK="https://calendly.com/example"

# Gmail Integration
GMAIL_USER="your-email@gmail.com"
GMAIL_PASSWORD="your-app-password"

# Twilio Integration
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."

# Webhook Settings
WEBHOOK_PORT=8080
WEBHOOK_HOST=0.0.0.0
WEBHOOK_SECRET=your_secret_token_here

# Calendar Integration
GOOGLE_CALENDAR_ID="primary"
